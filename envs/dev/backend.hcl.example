# 예시 파일이다. backend.hcl 로 복사한 뒤 bootstrap 의 출력 state_bucket 값을 bucket 에 적는다.
#   Copy-Item backend.hcl.example backend.hcl
# backend.hcl 은 계정 ID가 들어가므로 커밋하지 않는다(.gitignore).
bucket       = "aws-lab-tfstate-<계정 ID>"
key          = "envs/dev/terraform.tfstate"
region       = "ap-northeast-2"
encrypt      = true
use_lockfile = true # S3 객체로 잠금(Terraform 1.10+) — DynamoDB 테이블이 필요 없다
